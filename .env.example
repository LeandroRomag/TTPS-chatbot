# Configuración de Flask
SECRET_KEY=dev-secret-key-change-in-production

# Base de Datos PostgreSQL - Cambia estos valores según tu configuración local
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chatbot_db
# Si no usas docker y tu PostgreSQL está en localhost, podes usar:
# DB_HOST=localhost
# DB_PORT=5432

# WhatsApp Business API
WHATSAPP_TOKEN=tu_token_de_whatsapp_aqui
PHONE_NUMBER_ID=tu_phone_number_id_aqui
VERIFY_TOKEN=tu_token_de_verificacion_aqui

# Hugging Face API
HUGGINGFACE_API_TOKEN=tu_token_de_huggingface_aqui